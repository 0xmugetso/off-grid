# Arc is testnet-only. Do not put private keys in this file.
NEXT_PUBLIC_ARC_NETWORK=Arc_Testnet
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
# Optional dedicated Base Sepolia RPC. When omitted, OffGrid uses Base's
# documented public endpoints with automatic failover.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
# Required before enabling crypto-to-fiat session execution. This must be an
# audited/deployed Arc settlement contract; never use a personal/demo address.
NEXT_PUBLIC_ARC_SETTLEMENT_ADDRESS=
# Optional server-side Solana Devnet RPC. Use a dedicated provider in hosted
# environments; the browser only talks to OffGrid's authenticated proxy.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SESSION_SECRET=replace-with-at-least-32-random-characters
# Hosted persistence for Vercel. Neon/Vercel Postgres integrations usually
# provide POSTGRES_URL automatically; DATABASE_URL is also accepted.
DATABASE_URL=

# Circle Mint sandbox off-ramp. Server-side only; sandbox simulates bank money.
CIRCLE_MINT_BASE_URL=https://api-sandbox.circle.com
CIRCLE_MINT_API_KEY=
CIRCLE_MINT_BANK_ACCOUNT_ID=
PAYOUT_WEBHOOK_SECRET=

# Optional server-side provider credentials. Keep these out of NEXT_PUBLIC_* variables.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_ONRAMP_PUBLISHABLE_KEY=
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
